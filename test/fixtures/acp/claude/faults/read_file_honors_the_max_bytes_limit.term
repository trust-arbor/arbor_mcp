[
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :init,
      opts: [
        cwd: "<sandbox>/project",
        claude_config_dir: "<sandbox>/claude",
        cli_path: "<sandbox>/bin/claude"
      ]
    },
    result: %{tag: :ok}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-new",
        "jsonrpc" => "2.0",
        "method" => "session/new",
        "params" => %{"cwd" => "<sandbox>/project"}
      }
    },
    result: %{
      reply: %{
        "configOptions" => [
          %{
            "category" => "mode",
            "currentValue" => "default",
            "description" => "Session permission mode",
            "id" => "mode",
            "name" => "Mode",
            "options" => [
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Always ask before making changes",
                "name" => "Manual",
                "value" => "default"
              },
              %{
                "_meta" => %{"kind" => "standard"},
                "description" => "Automatically accept all file edits",
                "name" => "Accept edits",
                "value" => "acceptEdits"
              },
              %{
                "_meta" => %{"kind" => "plan"},
                "description" => "Create a plan before making changes",
                "name" => "Plan",
                "value" => "plan"
              },
              %{
                "_meta" => %{"kind" => "auto_review"},
                "description" => "Claude handles permission decisions",
                "name" => "Auto",
                "value" => "auto"
              }
            ],
            "type" => "select"
          },
          %{
            "category" => "model",
            "currentValue" => "default",
            "description" => "AI model to use",
            "id" => "model",
            "name" => "Model",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Sonnet", "value" => "sonnet"},
              %{"name" => "Opus", "value" => "opus"}
            ],
            "type" => "select"
          },
          %{
            "category" => "thought_level",
            "currentValue" => "default",
            "description" => "Available effort levels for this model",
            "id" => "effort",
            "name" => "Effort",
            "options" => [
              %{"name" => "Default", "value" => "default"},
              %{"name" => "Low", "value" => "low"},
              %{"name" => "Medium", "value" => "medium"},
              %{"name" => "High", "value" => "high"}
            ],
            "type" => "select"
          }
        ],
        "modes" => %{
          "availableModes" => [
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Always ask before making changes",
              "id" => "default",
              "name" => "Manual"
            },
            %{
              "_meta" => %{"kind" => "standard"},
              "description" => "Automatically accept all file edits",
              "id" => "acceptEdits",
              "name" => "Accept edits"
            },
            %{
              "_meta" => %{"kind" => "plan"},
              "description" => "Create a plan before making changes",
              "id" => "plan",
              "name" => "Plan"
            },
            %{
              "_meta" => %{"kind" => "auto_review"},
              "description" => "Claude handles permission decisions",
              "id" => "auto",
              "name" => "Auto"
            }
          ],
          "currentModeId" => "default"
        },
        "sessionId" => "claude_sdk_<1>"
      },
      tag: :reply
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{
        "id" => "acp-prompt",
        "jsonrpc" => "2.0",
        "method" => "session/prompt",
        "params" => %{"prompt" => "first", "sessionId" => "claude_sdk_<1>"}
      }
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "message" => %{"content" => [%{"text" => "first", "type" => "text"}], "role" => "user"},
          "parent_tool_use_id" => nil,
          "session_id" => "claude_sdk_<1>",
          "type" => "user"
        }
      ]
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :note,
      text: "ACP has line/limit fields rather than a byte cap; the adapter retains max_bytes and validates the correlated response before answering Claude"
    },
    result: %{}
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :inbound,
      message: %{
        "request" => %{
          "max_bytes" => 4,
          "path" => "<sandbox>/project/notes.md",
          "subtype" => "read_file"
        },
        "request_id" => "req-read",
        "type" => "control_request"
      }
    },
    result: %{
      messages: [
        %{
          "id" => "acp-<1>",
          "jsonrpc" => "2.0",
          "method" => "fs/read_text_file",
          "params" => %{"path" => "<sandbox>/project/notes.md", "sessionId" => "claude_sdk_<1>"}
        }
      ],
      tag: :messages
    }
  },
  %ExMCP.Test.ClaudeGolden.Entry{
    step: %{
      kind: :outbound,
      message: %{"id" => "acp-<1>", "jsonrpc" => "2.0", "result" => %{"content" => "body"}}
    },
    result: %{
      tag: :ok,
      writes: [
        %{
          "response" => %{
            "request_id" => "req-read",
            "response" => %{"absPath" => "<sandbox>/project/notes.md", "contents" => "body"},
            "subtype" => "success"
          },
          "type" => "control_response"
        }
      ]
    }
  }
]
