# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps

# Where third-party dependencies like ExDoc output generated docs.
/doc/
# But keep our docs folder (except auto-generated specs). The modern JSON schema is
# retained as a test fixture so clean checkouts can verify schema-derived behavior.
!/docs/
/docs/mcp-specs/*
!/docs/mcp-specs/2026-07-28/
/docs/mcp-specs/2026-07-28/*
!/docs/mcp-specs/2026-07-28/schema.json

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
arbor_mcp-*.tar

# Temporary files, for example, from tests.
/tmp/

# Repository-only API manifests and validation output.
/_verification/

# Dialyzer PLT files
/priv/plts/

# Coverage reports (see also /cover/ above)
/excoveralls.html

# OS files
.DS_Store

# Editor/IDE files
.vscode/
.idea/
.elixir_ls/
*.swp
*.swo
*~

# Environment files
.env
.env.local
.aider*

# Test output files
test_output.log

# Node.js dependencies for interop tests
test/interop/node_modules/

# Temporary sibling source checkout used by prepublication CI.
/.arbor-v2/
